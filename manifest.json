{
  "manifest_version": 3,
  "name": "Heimdall",
  "version": "0.1.0",
  "description": "Record audio only, video only, or audio plus video from one or more tabs at the same time.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "desktopCapture", "activeTab", "storage", "unlimitedStorage", "downloads"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Heimdall",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
